/*
DriverFrank Realistic - GamePad Viewer PS4
Base: o controle realista exatamente no visual aprovado.
Skin usada: PlayStation 4
Use este arquivo no campo "Edit CSS URL".
*/

.edit.controller.ds4,
.controller.ds4.edit,
.edit .controller.ds4 {
    width: 806px !important;
    height: 598px !important;
    background-image: url("data:image/png;base64,") !important;
    background-repeat: no-repeat !important;
    background-position: 0 0 !important;
    background-size: 806px 598px !important;
    overflow: visible !important;
}

/* Brilho/água correndo somente pelas partes verdes */
.edit.controller.ds4::after,
.controller.ds4.edit::after,
.edit .controller.ds4::after {
    content: "" !important;
    position: absolute !important;
    inset: 0 !important;
    width: 806px !important;
    height: 598px !important;
    pointer-events: none !important;
    z-index: 30 !important;

    background: linear-gradient(
        120deg,
        rgba(15,110,35,.05) 0%,
        rgba(70,255,90,.10) 25%,
        rgba(215,255,185,.95) 45%,
        rgba(85,255,180,.92) 52%,
        rgba(70,255,75,.18) 70%,
        rgba(15,110,35,.05) 100%
    ) !important;
    background-size: 330% 330% !important;

    -webkit-mask-image: url("data:image/png;base64,") !important;
    -webkit-mask-size: 806px 598px !important;
    -webkit-mask-repeat: no-repeat !important;
    mask-image: url("data:image/png;base64,") !important;
    mask-size: 806px 598px !important;
    mask-repeat: no-repeat !important;

    mix-blend-mode: screen !important;
    filter:
        drop-shadow(0 0 4px rgba(150,255,100,.95))
        drop-shadow(0 0 11px rgba(55,255,100,.72))
        drop-shadow(0 0 22px rgba(30,205,90,.42)) !important;

    animation: driverFrankFlow 2.8s linear infinite !important;
}

@keyframes driverFrankFlow {
    0% {
        background-position: 170% -15%;
        opacity: .48;
    }
    45% {
        opacity: 1;
    }
    100% {
        background-position: -90% 115%;
        opacity: .55;
    }
}

/* Analógicos: recorte do próprio controle realista, então continuam se movendo */
.edit .ds4 .stick,
.controller.ds4.edit .stick {
    -webkit-mask: none !important;
    mask: none !important;
    background-image: url("data:image/png;base64,") !important;
    background-color: transparent !important;
    background-repeat: no-repeat !important;
    background-position: center !important;
    background-size: 94px 94px !important;
    width: 94px !important;
    height: 94px !important;
    border-radius: 50% !important;
    filter: drop-shadow(0 0 5px rgba(70,255,70,.35)) !important;
}

.edit .ds4 .stick.pressed,
.controller.ds4.edit .stick.pressed {
    filter:
        brightness(1.12)
        drop-shadow(0 0 8px rgba(150,255,100,.95))
        drop-shadow(0 0 16px rgba(55,255,100,.72)) !important;
}

/* Os outros botões já existem no desenho da base.
   Aqui deixamos o elemento nativo transparente e só mostramos o feedback ao apertar. */
.edit .ds4 .button,
.edit .ds4 .face,
.edit .ds4 .bumper,
.edit .ds4 .trigger,
.edit .ds4 .back,
.edit .ds4 .start,
.edit .ds4 .meta,
.edit .ds4 .touchpad,
.controller.ds4.edit .button,
.controller.ds4.edit .face,
.controller.ds4.edit .bumper,
.controller.ds4.edit .trigger,
.controller.ds4.edit .back,
.controller.ds4.edit .start,
.controller.ds4.edit .meta,
.controller.ds4.edit .touchpad {
    background-image: none !important;
    background-color: transparent !important;
    opacity: 1 !important;
}

/* Botões principais */
.edit .ds4 .button.pressed,
.controller.ds4.edit .button.pressed {
    border-radius: 50% !important;
    background: rgba(130,255,105,.12) !important;
    box-shadow:
        0 0 8px 3px rgba(185,255,130,.92),
        0 0 18px 6px rgba(45,255,85,.55) !important;
}

/* D-pad */
.edit .ds4 .face.pressed,
.controller.ds4.edit .face.pressed {
    background: rgba(120,255,80,.18) !important;
    box-shadow:
        0 0 7px 2px rgba(170,255,110,.90),
        0 0 15px 4px rgba(50,255,80,.48) !important;
    border-radius: 10px !important;
}

/* SHARE / OPTIONS */
.edit .ds4 .back.pressed,
.edit .ds4 .start.pressed,
.controller.ds4.edit .back.pressed,
.controller.ds4.edit .start.pressed {
    border-radius: 20px !important;
    background: rgba(120,255,80,.14) !important;
    box-shadow: 0 0 12px 3px rgba(100,255,80,.70) !important;
}

/* PS */
.edit .ds4 .meta.pressed,
.controller.ds4.edit .meta.pressed {
    border-radius: 50% !important;
    background: rgba(120,255,80,.14) !important;
    box-shadow: 0 0 14px 4px rgba(100,255,80,.80) !important;
}

/* Touchpad */
.edit .ds4 .touchpad.pressed,
.controller.ds4.edit .touchpad.pressed {
    border-radius: 14px !important;
    background: rgba(60,255,85,.08) !important;
    box-shadow:
        inset 0 0 18px rgba(110,255,90,.35),
        0 0 15px rgba(60,255,80,.38) !important;
}

/* L1/R1 e L2/R2 */
.edit .ds4 .bumper.pressed,
.edit .ds4 .trigger,
.controller.ds4.edit .bumper.pressed,
.controller.ds4.edit .trigger {
    border-radius: 18px !important;
    background: rgba(80,255,80,.06) !important;
    box-shadow: 0 0 13px rgba(80,255,75,.55) !important;
}
